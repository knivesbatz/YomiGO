{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YomiGo",
  "version": "0.47.0",
  "identifier": "io.github.knivesbatz.yomigo",
  "build": {
    "frontendDist": "../mobile/app/src/main/assets/www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YomiGo",
        "width": 1120,
        "height": 740,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "focus": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
